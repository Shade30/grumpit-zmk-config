#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>

#define DEF_L 0
#define NUM_L 1
#define SYM_L 2
#define WIN_L 3
#define FN_L 4
#define CFG_L 5

&lt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mt {
    quick-tap-ms = <220>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mmv {
    time-to-max-speed-ms = <1000>;
};

&msc {
    time-to-max-speed-ms = <600>;
};

/ {
    combos {
        compatible = "zmk,combos";
//       ┏━━━━━━┳━━━━━━┳━━━━━━┓                 ┏━━━━━━┳━━━━━━┳━━━━━━┓       
//┏━━━━━━┫     (Q)   (TAB)    ┣━━━━━━┓   ┏━━━━━━┫   (BSPC)   (P)     ┣━━━━━━┓
//┃[SOFF]┃      ┃      ┃      ┃      ┃   ┃      ┃      ┃      ┃      ┃[SOFF]┃
//┃      ┃    (ESC)   (B)     ┃      ┃   ┃      ┃     (N)  (ENTER)   ┃      ┃
//┗━━━━━━┻━━━━━━┻━━━━━━┻━━━━━━┫[SOFF]┃   ┃[SOFF]┣━━━━━━┻━━━━━━┻━━━━━━┻━━━━━━┛
//                            ┗━━━━━━┛   ┗━━━━━━┛
        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp BSPC>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp ESC>;
        };

        combo_ent {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp RET>;
        };

        combo_b {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp B>;
        };
        
        combo_p {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp P>;
        };
        
        combo_q {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp Q>;
        };

        combo_n {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp N>;
        };

        combo_soff {
            timeout-ms = <50>;
            key-positions = <6 15 26 27>;
            bindings = <&soft_off>;
        };
    };

    behaviors {
        mt_h: mod_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap H";
        };
        lt_h: layer_tap_home {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap H";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                              &kp W        &kp E         &kp R                                   &kp U         &kp I        &kp O
                &mt_h LSHFT A &mt_h LGUI S &mt_h LALT D  &mt_h LCTRL F &kp T           &kp Y     &mt_h RCTRL J &mt_h RALT K &mt_h LGUI L   &mt_h RSHFT ;
                &lt WIN_L Z   &lt FN_L X   &kp C         &kp V         &kp G           &kp H     &kp M         &kp COMMA    &lt FN_L DOT   &lt WIN_L FSLH
                                                                       &lt NUM_L SPC   &mo SYM_L 
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                                 &none         &none           &none                                  &none            &none            &none
                &mt_h LSHFT EXCL &mt_h LGUI AT &mt_h LALT HASH &mt_h LCTRL DLLR &kp PRCNT   &kp CARET &mt_h RCTRL AMPS &mt_h RALT ASTRK &mt_h RGUI LPAR &mt_H RSHFT RPAR
                &kp N1           &kp N2        &kp N3          &kp N4           &kp N5      &kp N6    &kp N7           &kp N8           &kp N9          &kp N0
                                                                                &none       &mo CFG_L
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                            &none    &none     &kp PIPE                                  &kp HOME    &kp PSCRN  &kp PG_UP
                &none       &none    &none     &none      &kp SLCK            &kp CAPS   &kp DOWN    &kp UP     &kp RIGHT   &kp INSERT
                &none       &none    &none     &none      &kp PAUSE_BREAK     &kp LEFT   &kp END     &none      &kp PG_DN   &kp BSLH
                                                          &mo CFG_L           &none 
            >;
        };

        win_layer {
            display-name = "Win";
            bindings = <
                               &kp Q          &kp GRAVE      &kp B                                      &kp P             &kp LBKT         &kp RBKT
                &kp LG(LS(N1)) &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &none         &none         &mt_h RCTRL MINUS &mt_h RALT EQUAL &mt_h RGUI BSLH &kp SQT
                &kp LG(N1)     &kp LG(N2)     &kp LG(N3)     &kp LG(N4)     &none         &kp LC(GRAVE) &kp LG(N7)        &kp LG(N8)       &kp LG(N9)      &kp LG(N0)
                                                                            &kp LG(N5)    &kp LG(N6)
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                        &none   &none   &none                      &kp F12  &none   &none
                &kp F1  &kp F2  &kp F3  &kp F4  &none     &kp F11  &kp F7   &kp F8  &kp F9  &kp F10
                &none   &none   &none   &none   &kp F5    &kp F6   &none    &none   &none   &none
                                                &none     &none
            >;
        };

        cfg_layer {
            display-name = "Cfg";
            bindings = <
                             &bootloader  &none        &none                          &none           &none          &none
                &ind_bat     &ind_con     &none        &none   &soft_off     &none    &mmv MOVE_LEFT  &mmv MOVE_UP   &mmv MOVE_RIGHT  &msc SCRL_UP
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none   &bt BT_CLR    &mkp MB3 &msc SCRL_LEFT  &mmv MOVE_DOWN &msc SCRL_RIGHT  &msc SCRL_DOWN
                                                               &mkp MB1      &mkp MB2
            >;
        };
    };
};
